---
import "../styles/global.scss";
// import BaseLayout from "../layouts/BaseLayout.astro"
import SinglePageLayout from "../layouts/SinglePageLayout.astro"

---

<SinglePageLayout>
  <div class="background-container">
    <picture>
      <source 
        srcset="https://firebasestorage.googleapis.com/v0/b/mjb-web-ae899.appspot.com/o/ASSETS%2FSAVE_20210824_205528.jpg?alt=media&token=c412e7ed-4cc9-40c4-896f-68bbf09dcd4f" 
        media="(min-width: 600px)" />
      <img
        src="https://firebasestorage.googleapis.com/v0/b/mjb-web-ae899.appspot.com/o/ASSETS%2FSAVE_20210824_205528.jpg?alt=media&token=c412e7ed-4cc9-40c4-896f-68bbf09dcd4f"
        alt="Background"
        class="main-background"
      />
    </picture>
    <div class="background-overlay"></div>
  </div>

  <section class="main-content text-light">
    <h2>SAVE THE DATE</h2>
    <div class="main-title">
      <h1>May <span>&</span> Juli</h1>
    </div>
    <div class="date">
      <h2>SÁBADO</h2>
      <div class="date-number">21</div>
      <h2>DICIEMBRE</h2>
    </div>
    <h2>HACIENDA SANTA CECILIA</h2>
    <h4>Sáchica, Boyacá</h4>
  </section>

</SinglePageLayout>


<style lang="scss">

.main-content {
  width: 100dvw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  // height: calc(100dvh - 80px);
  height: 100dvh; //Remove on full content version
  // height: 100%;
  gap: 2ch;

  h4 {
    text-align: center;
  }
}

.date .date-number {
  text-align: center;
  font-size: 32px;
  border-left: 1px var(--font-light-color) solid;
  border-right: 1px var(--font-light-color) solid;
  padding-left: 5px;
  padding-right: 5px;
}


.date {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 10px;

  h2 {
    min-width: 100px;
  }
}

.main-title {
  span {
    font-family: "Alice", serif;
    font-size: 48px;
  }

  h1 {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
}
@media screen and (max-width: 600px) {
  .main-title {
    h1 {
      margin: 0;
    }
  }
}
</style>
