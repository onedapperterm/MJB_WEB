---
import { fetchAllGuests } from "@/firebase/services/getters";
import BackLayout from "../../layouts/BackLayout.astro";
import type { Guest } from "@/model/guest.data";


const guests: Guest[] = await fetchAllGuests() || [];

---
<BackLayout pageTitle="Guests Admin">

  <h1>Guest Table</h1>

  <table class="table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Reference</th>
        <th scope="col">Name</th>
        <th scope="col">Confirmed</th>
        <th scope="col">Attending</th>
        <th scope="col">Cheked</th>
        <th scope="col">Stay at hotel</th>
        <th scope="col">id</th>
      </tr>
    </thead>
    <tbody>
      {guests.map((guest, i) => (
        <tr>
          <th scope="row">{i + 1}</th>
          <td>{guest.reference}</td>
          <td>{guest.firstName} {guest.lastName}</td>
          <td>{guest.confirmed ? 'Confirmado' : 'No Confirmado'}</td>
          <td>{guest.attendance ? 'Asistrá' : (guest.confirmed ? 'No Asistirá' : 'No Confirmado aún')}</td>
          <td>{guest.checked ? 'Chequeado' : 'No Chequeado'}</td>
          <td>{guest.stayAtHotel ? 'Si' : (guest.confirmed ? 'No' : 'No Confirmado aún')}</td>
          <td>{guest.id}</td>
        </tr>
      ))}
    </tbody>


</BackLayout>

<style lang="scss">

</style>
